        <mxCell id="NWnw438_ii4KseSDQwQc-54" value="&lt;b&gt;JS&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" parent="1" vertex="1">
