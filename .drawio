          <mxGeometry x="320" y="110" width="50" height="70" as="geometry" />
        </mxCell>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-8" value="L" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="50" height="70" as="geometry" />
        </mxCell>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-9" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0;exitDx=0;exitDy=25;exitPerimeter=0;entryX=0.44;entryY=0.386;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-8" target="MRw4TNc32QCG-R8J6Bpx-8">
