  <diagram id="-QfaeNDfP-1TMKs4Ucob" name="Stránka-3">
    <mxGraphModel dx="959" dy="1956" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-1" value="VoltCore_Marketing" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="-20" width="120" height="60" as="geometry" />
        </mxCell>
        <object label="Elektrotrans a.s." Data_Input="Elektrotrans a.s.&#xa;Zaměření: Specialista na stavbu a rekonstrukce nadzemních vedení VVN a ZVN (110 kV, 220 kV, 400 kV). Dělají vše na klíč od projekce po samotné stožáry.&#xa;&#xa;Úspěšnost &amp; Hodnocení: A+ (Špička na trhu). Patří k absolutní elitě v ČR. Jsou klíčovým partnerem pro ČEPS a ČEZ Distribuce. Mají špičkové technické vybavení pro tahání lan a montáže v těžkém terénu. Stabilní, technologicky nejdále." link="older/Architecture_Draw.io/Společnosti_Strategie/Elektrotrans_Strategie.docx" linkTarget="_blank" id="MRw4TNc32QCG-R8J6Bpx-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="20" y="290" width="120" height="60" as="geometry" />
          </mxCell>
        </object>
        <object label="Egem a.s." Data_Input="EGEM s.r.o.&#xa;Zaměření: Komplexní služby v energetice, výstavba a rekonstrukce rozvoden a vedení VVN i VN.&#xa;&#xa;Úspěšnost &amp; Hodnocení: A+ (Klíčový hráč). Obrovská firma s obratem v miliardách korun. Jsou schopni realizovat ty nejsložitější přechody vedení, zdvojování systémů a modernizace starých tras. Mají obrovské personální i materiální zázemí." link="/home/lfds/Documents/VoltCore_Nexus-OpenFolder/Architecture_Draw.io/Společnosti_Strategie/Egem_Strategie.docx" id="MRw4TNc32QCG-R8J6Bpx-3">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="170" y="340" width="70" height="60" as="geometry" />
          </mxCell>
        </object>
        <object label="SAG Elektrovod&amp;nbsp;" Data_Input="SAG Elektrovod (působící přes českou organizační složku / Eqos Energie)&#xa;Zaměření: Výstavba stožárů a linkového vedení nejvyšších napěťových hladin. Tradiční značka s kořeny na Slovensku, ale silnou stopou v ČR.&#xa;&#xa;Úspěšnost &amp; Hodnocení: A (Velmi úspěšná). Dlouhodobě stabilní firma na českém trhu. Specializuje se na velké investiční celky. Pokud jde o stavbu nových příhradových konstrukcí VVN, patří mezi první volby investorů." link="older/Architecture_Draw.io/Společnosti_Strategie/SAG_Strategie.docx" id="MRw4TNc32QCG-R8J6Bpx-4">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="290" y="310" width="100" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-10" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-7" target="MRw4TNc32QCG-R8J6Bpx-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-13" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-7" target="MRw4TNc32QCG-R8J6Bpx-3">
