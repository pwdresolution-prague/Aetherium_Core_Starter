          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-12" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-2" target="MRw4TNc32QCG-R8J6Bpx-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="MSEM a.s." Data_Input="MSEM, a.s. (Moravskoslezské elektromontáže)&#xa;Zaměření: Výstavba venkovních a kabelových sítí VN, NN a částečně VVN. Opravy základů a nátěry stožárů, montáže trafostanic.&#xa;&#xa;Úspěšnost &amp; Hodnocení: B+ (Regionální leader). Extrémně silná firma na Moravě a ve Slezsku, hlavní partner pro ČEZ Distribuci v tomto regionu. Velmi spolehlivá na rekonstrukce a poruchové služby." link="older/Architecture_Draw.io/Společnosti_Strategie/MSEM_Strategie.docx" id="MRw4TNc32QCG-R8J6Bpx-15">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="450" y="240" width="70" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-18" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-16">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <object label="Senergos a.s." Data_Input="Senergos, a.s.&#xa;Zaměření: Liniové stavby VVN, obnova a výstavba VN a NN, montáže kabelových souborů a vyvedení výkonu z obnovitelných zdrojů.&#xa;&#xa;Úspěšnost &amp; Hodnocení: B+ (Rostoucí a flexibilní). Velmi dravá a moderní firma, která úspěšně kombinuje klasické linky s novou energetikou (připojování velkých fotovoltaik a větrníků do sítě VN/VVN)." link="older/Architecture_Draw.io/Společnosti_Strategie/Senergos_Strategie.docx" id="MRw4TNc32QCG-R8J6Bpx-16">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="560" y="240" width="90" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-17" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-15" target="MRw4TNc32QCG-R8J6Bpx-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="Omexom a.s." Data_Input="OMEXOM GA Energo s.r.o.&#xa;Zaměření: Výstavba a rekonstrukce vedení všech napěťových hladin, od NN po VVN.&#xa;&#xa;Úspěšnost &amp; Hodnocení: A- (Mezinárodní zázemí). Součást silné skupiny VINCI. Mají obrovské know-how a díky mezinárodnímu krytí vyhrávají velké tendry na modernizace distribučních soustav po celé republice." link="older/Architecture_Draw.io/Společnosti_Strategie/Omexom_Strategie.docx" id="MRw4TNc32QCG-R8J6Bpx-19">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="680" y="240" width="100" height="60" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="MRw4TNc32QCG-R8J6Bpx-20" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="MRw4TNc32QCG-R8J6Bpx-19" target="MRw4TNc32QCG-R8J6Bpx-8">
          <mxGeometry relative="1" as="geometry" />
