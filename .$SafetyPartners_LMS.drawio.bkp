  <diagram id="o35mwmcitqjASCV2UP0l" name="Stránka-4">
    <mxGraphModel dx="969" dy="787" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="7gMIB0_B7x6YAe1S-Fv2-1" value="&lt;b&gt;LMS Monetizace&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        <object label="MODEL A — SaaS měsíční licence" Saas="Nejběžnější.&#xa;&#xa;Firma platí:&#xa;&#xa;měsíčně / za uživatele / za organizaci&#xa;&#xa;Například:&#xa;&#xa;Typ firmy&#x9;Cena&#xa;malá firma&#x9;5 000 – 20 000 Kč/měs&#xa;střední firma&#x9;20 000 – 80 000 Kč/měs&#xa;enterprise&#x9;100 000 – 500 000+ Kč/měs&#xa;&#xa;Pokud máš:&#xa;&#xa;reporting,&#xa;bezpečnost,&#xa;API,&#xa;onboarding,&#xa;vlastní CMS,&#xa;biometrické analýzy,&#xa;audit," id="7gMIB0_B7x6YAe1S-Fv2-2">
          <mxCell style="swimlane;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="360" y="50" width="240" height="40" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="7gMIB0_B7x6YAe1S-Fv2-25" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="7gMIB0_B7x6YAe1S-Fv2-3" target="7gMIB0_B7x6YAe1S-Fv2-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="MODEL B — Per User Licensing" Saas="Například:&#xa;&#xa;149 Kč – 1200 Kč / uživatel / měsíc&#xa;&#xa;Záleží:&#xa;&#xa;co systém umí,&#xa;compliance,&#xa;bezpečnost,&#xa;AI,&#xa;reporting,&#xa;certifikace.&#xa;&#xa;Například:&#xa;&#xa;Uživatelů&#x9;Cena&#xa;100 lidí&#x9;15k – 80k/měs&#xa;1000 lidí&#x9;150k – 800k/měs" id="7gMIB0_B7x6YAe1S-Fv2-3">
          <mxCell style="swimlane;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="360" y="130" width="240" height="40" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="7gMIB0_B7x6YAe1S-Fv2-26" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="7gMIB0_B7x6YAe1S-Fv2-4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <object label="MODEL C&amp;nbsp;Enterprise Contract" Saas="Toto je nejzajímavější.&#xa;&#xa;Firma:&#xa;&#xa;chce custom úpravy,&#xa;vlastní branding,&#xa;vlastní workflow,&#xa;vlastní infrastrukturu.&#xa;&#xa;Pak se účtuje:&#xa;&#xa;Implementace&#xa;&#xa;např.&#xa;&#xa;300 000 Kč – 5 000 000 Kč+&#xa;&#xa;PLUS:&#xa;&#xa;měsíční maintenance&#xa;20 000 – 250 000 Kč/měs" id="7gMIB0_B7x6YAe1S-Fv2-4">
          <mxCell style="swimlane;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="360" y="220" width="240" height="40" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="7gMIB0_B7x6YAe1S-Fv2-27" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="7gMIB0_B7x6YAe1S-Fv2-5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <object label="MODEL D&amp;nbsp;White Label LMS" Saas="To je extrémně silné.&#xa;&#xa;Firma:&#xa;&#xa;používá LMS pod vlastní značkou,&#xa;ale backend je tvůj.&#xa;&#xa;Tam:&#xa;&#xa;můžeš účtovat velmi vysoké částky.&#xa;&#xa;Například:&#xa;&#xa;50 000 – 500 000 Kč měsíčně&#xa;&#xa;podle:&#xa;&#xa;velikosti,&#xa;SLA,&#xa;podpory,&#xa;uptime,&#xa;custom integrací." id="7gMIB0_B7x6YAe1S-Fv2-5">
          <mxCell style="swimlane;whiteSpace=wrap;html=1;" vertex="1" parent="1">
            <mxGeometry x="360" y="300" width="240" height="40" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="7gMIB0_B7x6YAe1S-Fv2-24" style="edgeStyle=entityRelationEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=none;segment=10;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="7gMIB0_B7x6YAe1S-Fv2-22" target="7gMIB0_B7x6YAe1S-Fv2-2">
