        <object label="WebSockets" Web_Socket_JS="// Přihlášení k odběru změn v tabulce &#39;profiles&#39;&#xa;const channel = supabase&#xa;  .channel(&#39;verejne-zmeny&#39;)&#xa;  .on(&#xa;    &#39;postgres_changes&#39;, &#xa;    { event: &#39;INSERT&#39;, schema: &#39;public&#39;, table: &#39;profiles&#39; }, &#xa;    (payload) =&gt; {&#xa;      console.log(&#39;Někdo se právě registroval!&#39;, payload.new);&#xa;      // Tady zavoláš funkci, která ti přičte +1 k té tvé oranžové 352&#xa;      aktualizujCisloVHTML(payload.new);&#xa;    }&#xa;  )&#xa;  .subscribe()" id="ySIeFoPE9C9uG5erzaKy-1">
