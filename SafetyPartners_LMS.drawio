        <object label="Analytika" Grafy_Knihovna_Návrh_kodu="// Data, která ti vypadnou ze Supabase (příklad)&#xa;const rawData = [&#xa;  { den: &#39;Po&#39;, aktivita: 10 },&#xa;  { den: &#39;Út&#39;, aktivita: 25 },&#xa;  { den: &#39;St&#39;, aktivita: 15 }&#xa;];&#xa;&#xa;// Formátování pro graf (tohle chce knihovna)&#xa;const chartData = {&#xa;  labels: rawData.map(item =&gt; item.den), // [&#39;Po&#39;, &#39;Út&#39;, &#39;St&#39;]&#xa;  datasets: [{&#xa;    label: &#39;Aktivita uživatelů&#39;,&#xa;    data: rawData.map(item =&gt; item.aktivita), // [10, 25, 15]&#xa;    borderColor: &#39;#ff8000&#39;, // Tvoje oranžová z proměnné&#xa;    backgroundColor: &#39;rgba(255, 128, 0, 0.2)&#39;,&#xa;    tension: 0.4 // To udělá tu hezkou vlnku, co máš v návrhu&#xa;  }]&#xa;};" id="ySIeFoPE9C9uG5erzaKy-3">
